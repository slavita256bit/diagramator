{
  "styleVersion": 2,
  "name": "PlantUML",
  "font": ["Arial", "Liberation Sans", "sans-serif"],
  "fontSize": 12,
  "nameFontSize": 13,
  "stereotypeFontSize": 11,
  "lineHeight": 18,
  "paddingX": 8,
  "paddingY": 4,
  "borderWidth": 1,
  "cornerRadius": 3,
  "nameBold": false,
  "kindBadge": true,
  "colors": {
    "text": "#000000",
    "border": "#a80036",
    "fill": "#fefece",
    "headerFill": "#fefece",
    "edge": "#a80036",
    "badge": "#add1b2"
  },
  "orthogonalEdges": false,
  "edgeMergeTargets": true,
  "edgeEditable": false,
  "edgeClearance": 12,
  "edgePortSpacing": 20,
  "edgeBendPenalty": 24,
  "edgeSourceSide": "top",
  "edgeTargetSide": "bottom",
  "edgeWidth": 1,
  "arrowSize": 12,
  "edgeDashLength": 6,
  "edgeDashGap": 4,
  "interfaceHidesAttributes": false,
  "showStereotype": true,
  "templateNotation": "header",
  "memberIconStyle": "circle",
  "showMethodParams": true,
  "showMethodReturnType": true
}
