{
  "styleVersion": 2,
  "name": "Visual Studio",
  "font": ["Arial", "Liberation Sans", "sans-serif"],
  "fontSize": 12,
  "nameFontSize": 13,
  "stereotypeFontSize": 11,
  "lineHeight": 18,
  "paddingX": 8,
  "paddingY": 4,
  "borderWidth": 1,
  "cornerRadius": 6,
  "nameBold": true,
  "kindBadge": false,
  "colors": {
    "text": "#1e1e1e",
    "border": "#7a96c2",
    "fill": "#f7f9fc",
    "headerFill": "#d6e2f5",
    "edge": "#4d6a99",
    "badge": "#d6e2f5"
  },
  "orthogonalEdges": false,
  "edgeMergeTargets": true,
  "edgeEditable": false,
  "edgeClearance": 12,
  "edgePortSpacing": 20,
  "edgeBendPenalty": 24,
  "edgeSourceSide": "top",
  "edgeTargetSide": "bottom",
  "edgeWidth": 1,
  "arrowSize": 12,
  "edgeDashLength": 6,
  "edgeDashGap": 4,
  "interfaceHidesAttributes": false,
  "showStereotype": true,
  "templateNotation": "header",
  "memberIconStyle": "shape",
  "showMethodParams": true,
  "showMethodReturnType": true
}
