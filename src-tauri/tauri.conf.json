{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diagramator",
  "version": "0.1.0",
  "identifier": "com.diagramator.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Diagramator",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../examples/": "examples/",
      "../THIRD_PARTY_LICENSES/": "licenses/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBKEY_FROM_pnpm_tauri_signer_generate",
      "endpoints": [
        "https://github.com/slavita256bit/diagramator/releases/latest/download/latest.json"
      ]
    }
  }
}
